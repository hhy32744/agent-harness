{
  "name": "ts-fetch-lab",
  "version": "1.0.0",
  "description": "TypeScript 项目骨架 + Node 环境下的网页 fetch 抓取实验",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "typescript",
    "fetch",
    "node"
  ],
  "author": "hhy",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
